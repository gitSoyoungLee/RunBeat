<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 화면. 헤더(뒤로 + "설정")는 BaseActivity가 위에 붙여 준다 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ───────── 러닝 ───────── -->
        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="8dp"
            android:text="러닝" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 자동 일시정지 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="자동 일시정지"
                        android:textColor="@color/text"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="멈추면 기록과 타이머가 함께 멈춰요 · 대회 땐 끄기"
                        android:textColor="@color/sub"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAutoPause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/card_stroke" />

            <!-- 체중 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="체중"
                        android:textColor="@color/text"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="칼로리 계산에 사용돼요"
                        android:textColor="@color/sub"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etWeight"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="kg"
                    android:textColor="@color/sub"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ───────── 기기 ───────── -->
        <TextView
            style="@style/SectionTitle"
            android:text="기기" />

        <!-- 배터리 최적화 해제: 카드 전체가 버튼 -->
        <LinearLayout
            android:id="@+id/rowBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_click"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_battery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="배터리 최적화 해제"
                    android:textColor="@color/text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvBatteryState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="화면이 꺼져도 기록이 끊기지 않게"
                    android:textColor="@color/sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="@color/sub"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
