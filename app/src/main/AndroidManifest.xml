<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 위치(GPS) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 화면이 꺼져도 계속 동작하는 Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 걸음 감지 센서(케이던스) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 화면이 꺼져도 CPU 유지 (메트로놈 박자 정확도) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 지도 타일 다운로드 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 기록 이미지를 갤러리에 저장 (Android 9 이하에서만 필요, 10 이상은 권한 없이 저장) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="RunBeat"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="러닝 기록" />

        <activity
            android:name=".RunDetailActivity"
            android:exported="false"
            android:label="러닝 상세" />

        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:label="경로 지도" />

        <activity
            android:name=".CourseListActivity"
            android:exported="false"
            android:label="코스 고르기" />

        <activity
            android:name=".CourseEditActivity"
            android:exported="false"
            android:label="코스 편집"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".RunService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
